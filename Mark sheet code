import java.util.Scanner;

public class ReadKB {
    public static void main(String[] args) {
        // Create Scanner object to read from keyboard
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter your name: ");
        String name = scanner.nextLine();

        System.out.print("Enter your register number: ");
        int rno = scanner.nextInt();

        System.out.print("Enter your English mark: ");
        int english = scanner.nextInt();

        System.out.print("Enter your Hindi mark: ");
        int hindi = scanner.nextInt();

        System.out.print("Enter your Malayalam mark: ");
        int mal = scanner.nextInt();

        int total = english + hindi + mal;
        float avg = total / 3.0f;

        // Print Mark Sheet
        System.out.println("\n\n********** MARK SHEET **********");
        System.out.println("Name: " + name);
        System.out.println("Register Number: " + rno);
        System.out.println("English: " + english);
        System.out.println("Hindi: " + hindi);
        System.out.println("Malayalam: " + mal);
        System.out.println("Total: " + total);
        System.out.println("Average: " + avg);
        System.out.println("********************************\n\n");
    }
}
