public class PatternExample {
    public static void main(String[] args) {
        // Ascending Pattern
        System.out.println("Ascending Order (A to E):");
        for (int i = 1; i <= 5; i++) {
            char ch = 'A';
            for (int j = 1; j <= i; j++) {
                System.out.print(ch + " ");
                ch++;
            }
            System.out.println();
        }

        System.out.println(); // separator line

        // Descending Pattern
        System.out.println("Descending Order (E to A):");
        for (int i = 5; i >= 1; i--) {
            char ch = 'A';
            for (int j = 1; j <= i; j++) {
                System.out.print(ch + " ");
                ch++;
            }
            System.out.println();
        }
    }
}
